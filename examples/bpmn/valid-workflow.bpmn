<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Valid" targetNamespace="https://workflowguard.dev/examples">
  <bpmn:process id="Process_Valid" name="Valid BPMN workflow" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Request received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Approval_1" name="Approve request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Notify_1" name="Notify requester">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Approval_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Approval_1" targetRef="Notify_1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Notify_1" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
