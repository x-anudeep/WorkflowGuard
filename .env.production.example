# Backend
WORKFLOWGUARD_ENVIRONMENT=production
WORKFLOWGUARD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/workflowguard
WORKFLOWGUARD_CORS_ORIGINS=["https://YOUR_FRONTEND_DOMAIN"]
# AI provider: none | groq | openai
# For Groq set WORKFLOWGUARD_AI_PROVIDER=groq and use a Groq model id, e.g.:
#   WORKFLOWGUARD_AI_MODEL=openai/gpt-oss-120b
WORKFLOWGUARD_AI_PROVIDER=none
WORKFLOWGUARD_AI_API_KEY=
WORKFLOWGUARD_AI_MODEL=gpt-4o-mini
WORKFLOWGUARD_AI_TIMEOUT_SECONDS=20

# Frontend
# On Vercel set NEXT_PUBLIC_API_BASE_URL to the relative path /api instead, so browser
# calls stay same-origin through the rewrite in apps/web/vercel.json. See docs/vercel.md.
NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_DOMAIN/api
INTERNAL_API_BASE_URL=https://YOUR_API_DOMAIN/api
WORKFLOWGUARD_FUZZ_MAX_CASES=60
WORKFLOWGUARD_FUZZ_DEFAULT_SEED=1337

# n8n executes workflow tests. Create an API key with scripts/bootstrap_n8n.py, or in the
# editor at Settings > n8n API; it needs the workflow:activate scope or publishing 403s.
WORKFLOWGUARD_N8N_BASE_URL=http://n8n:5678
WORKFLOWGUARD_N8N_API_KEY=
# n8n calls this back mid-run, so it must be reachable from the n8n container.
WORKFLOWGUARD_MOCK_BASE_URL=http://api:8000/mock
